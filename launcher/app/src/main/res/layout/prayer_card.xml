<?xml version="1.0" encoding="utf-8"?>
<!-- The prayer reminder PrayerReminderService shows top right over any app: the Inputs dropdown's glass
     panel with the prayer's name and time. Never focusable; the app underneath keeps the remote. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="220dp"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:paddingStart="22dp"
    android:paddingEnd="26dp"
    android:paddingTop="14dp"
    android:paddingBottom="15dp">

    <TextView
        android:id="@+id/prayerCardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textSize="19sp"
        android:fontFamily="@font/outfit_medium" />

    <TextView
        android:id="@+id/prayerCardDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/outfit_regular"
        android:letterSpacing="0.04" />
</LinearLayout>
